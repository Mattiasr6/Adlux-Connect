# Copiar a chatbot/.env y ajustar valores. El .env real NUNCA se commitea.
DJANGO_SECRET_KEY=cambiar-esta-clave-en-produccion
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Dónde corre Ollama (host con GPU). Sin esto, el chat usa localhost:11434.
OLLAMA_BASE_URL=http://100.78.144.4:11434
# Silencia la telemetría de ChromaDB (ruido en los logs).
ANONYMIZED_TELEMETRY=False
# Colección Chroma a usar (default: hospital_qanda2, datos originales).
COLECCION_FAQ=hospital_qanda2
