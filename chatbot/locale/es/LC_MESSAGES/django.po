#: chat/admin.py:23
msgid "Question"
msgstr "Pregunta"

#: chat/admin.py:27
msgid "Answer"
msgstr "Respuesta"

#: chat/management/commands/indexar_faq.py:16
msgid ""
"Index Q&A pairs from a JSON file into Chroma. Idempotent: skips existing ids."
msgstr "Indexa pares Q&A desde un JSON a Chroma. Idempotente: omite ids ya existentes."

#: chat/management/commands/indexar_faq.py:20
msgid "Path to the JSON file (relative to BASE_DIR or absolute)."
msgstr "Ruta al JSON (relativa a BASE_DIR o absoluta)."

#: chat/management/commands/indexar_faq.py:28
#, python-brace-format
msgid "missing file: {path}"
msgstr "no existe: {path}"

#: chat/management/commands/indexar_faq.py:49
#, python-brace-format
msgid "{new} new, {existing} already indexed. Total in {collection}: {total}"
msgstr "{new} nuevos, {existing} ya estaban. Total en {collection}: {total}"

#: chat/management/commands/promover_faq.py:17
msgid "Promote highly-rated answers to the FAQ. Idempotent."
msgstr "Promueve a la FAQ las respuestas con feedback alto. Idempotente."

#: chat/management/commands/promover_faq.py:21
msgid "Minimum feedback to promote (default: 3)."
msgstr "Feedback mínimo para promover (default: 3)."

#: chat/management/commands/promover_faq.py:45
#, python-brace-format
msgid ""
"{promoted} promoted (threshold {threshold}). Total in {collection}: {total}"
msgstr "{promoted} promovidas (umbral {threshold}). Total en {collection}: {total}"

